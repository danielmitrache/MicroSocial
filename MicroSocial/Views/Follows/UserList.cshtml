@model IEnumerable<MicroSocial.Models.ApplicationUser>

@{
    ViewData["Title"] = "User List";
}

<div class="container mt-4">
    <h2>@ViewData["Title"]</h2>
    <hr/>
    @if (Model != null && Model.Any())
    {
        <div class="list-group">
            @foreach (var user in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                         @if (!string.IsNullOrEmpty(user.ProfilePicture))
                        {
                            <img src="@user.ProfilePicture" class="rounded-circle me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                        else
                        {
                            <img src="/uploads/default_profile_picture.jpg" class="rounded-circle me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                        <div>
                            <h5 class="mb-0">@user.FirstName @user.LastName</h5>
                        </div>
                    </div>
                    <a asp-controller="Profiles" asp-action="Show" asp-route-id="@user.Id" class="btn btn-outline-primary btn-sm">View Profile</a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">List is empty.</div>
    }
    <div class="mt-3">
        <a href="javascript:history.back()" class="btn btn-secondary">Back</a>
    </div>
</div>
