@model Post
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Post Details";
    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="container mt-4">
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                     <h5 class="card-title">@Model.User?.UserName</h5>
                     <h6 class="card-subtitle mb-2 text-muted">@Model.CreatedAt.ToLocalTime().ToString("g")</h6>
                </div>
                @if (currentUser != null && (Model.UserId == currentUser.Id || User.IsInRole("Administrator")))
                {
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model.PostId" class="btn btn-sm btn-outline-secondary me-1">Edit</a>
                         <form asp-action="Delete" asp-route-id="@Model.PostId" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this post?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                }
            </div>
            <p class="card-text">@Model.Content</p>

            @if (Model.MediaType == MediaType.Image && !string.IsNullOrEmpty(Model.MediaPath))
            {
                <img src="@Model.MediaPath" class="img-fluid mt-2 rounded" style="max-height: 600px; width: 100%; object-fit: contain;" alt="Post image" />
            }
            else if (Model.MediaType == MediaType.Video && !string.IsNullOrEmpty(Model.MediaPath))
            {
                <video controls class="img-fluid mt-2 rounded" style="max-height: 600px; width: 100%;">
                    <source src="@Model.MediaPath" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            }
            
             <div class="d-flex align-items-center mt-3">
                 <!-- Like Button -->
                <form asp-controller="Likes" asp-action="ToggleLike" method="post" class="me-3">
                    <input type="hidden" name="postId" value="@Model.PostId" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                     <button type="submit" class="btn btn-sm @(currentUser != null && Model.Likes.Any(l => l.UserId == currentUser.Id) ? "btn-danger" : "btn-outline-danger")">
                        ❤ @Model.Likes.Count
                    </button>
                </form>
            </div>
        </div>
    </div>

    <h4>Comments</h4>
    <hr />
    
    @if (User.Identity.IsAuthenticated)
    {
        <div class="mb-4">
            <form asp-controller="Comments" asp-action="AddComment" method="post">
                <input type="hidden" name="postId" value="@Model.PostId" />
                <div class="form-group mb-2">
                    <textarea name="content" class="form-control @(ViewBag.ModerationError != null ? "is-invalid" : "")" rows="2" placeholder="Write a comment..."></textarea>
                    @if (ViewBag.ModerationError != null)
                    {
                        <span class="text-danger">@ViewBag.ModerationError</span>
                    }
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Add Comment</button>
            </form>
        </div>
    }
    else
    {
        <div class="alert alert-info">Please <a href="/Identity/Account/Login">login</a> to comment.</div>
    }

    <div class="comments-list">
        @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <div class="d-flex justify-content-between">
                        <div>
                            <strong>@comment.User?.UserName</strong>
                            <small class="text-muted ms-2">@comment.CreatedAt.ToLocalTime().ToString("g")</small>
                        </div>
                        @if (currentUser != null && (comment.UserId == currentUser.Id || User.IsInRole("Administrator")))
                        {
                             <form asp-controller="Comments" asp-action="Delete" asp-route-id="@comment.CommentId" method="post" onsubmit="return confirm('Are you sure?');">
                                <button type="submit" class="btn btn-sm btn-link text-danger p-0">×</button>
                            </form>
                        }
                    </div>
                    <p class="mb-0">@comment.Content</p>
                </div>
            </div>
        }
    </div>
    
    <div class="mt-3">
        <a asp-action="Index">Back to Feed</a>
    </div>
</div>
