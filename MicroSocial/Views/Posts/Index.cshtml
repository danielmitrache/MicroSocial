@model IEnumerable<Post>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Posts";
    var currentUser = await UserManager.GetUserAsync(User);
    var followingIds = (List<string>)ViewBag.FollowingIds ?? new List<string>();

    var postsFromFollowing = Model.Where(p => followingIds.Contains(p.UserId)).ToList();
    var otherPosts = Model.Except(postsFromFollowing).ToList();
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>News Feed</h1>
        @if (User.Identity.IsAuthenticated)
        {
            <a asp-action="Create" class="btn btn-primary">Create New Post</a>
        }
    </div>

    @* --- ACCOUNTS YOU FOLLOW --- *@
    @if (User.Identity.IsAuthenticated)
    {
        <h4 class="mb-3 text-primary">Accounts you follow</h4>
        @if (postsFromFollowing.Any())
        {
            <div class="mb-5">
                @foreach (var item in postsFromFollowing)
                {
                    <partial name="_PostPartial" model="item" />
                }
            </div>
        }
        else
        {
            <div class="alert alert-secondary mb-5">
                <p class="mb-0">No posts from accounts you follow. <a asp-controller="Profiles" asp-action="Search">Find people to follow!</a></p>
            </div>
        }
        
        <hr />
    }

    @* --- OTHER POSTS --- *@
    <h4 class="mb-3 text-secondary">Other posts</h4>
    @if (otherPosts.Any())
    {
        <div>
            @foreach (var item in otherPosts)
            {
                <partial name="_PostPartial" model="item" />
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No other posts found.
        </div>
    }
</div>
