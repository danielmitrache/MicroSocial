@model IEnumerable<Post>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Posts";
    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Recent Posts</h1>
        @if (User.Identity.IsAuthenticated)
        {
            <a asp-action="Create" class="btn btn-primary">Create New Post</a>
        }
    </div>

    @foreach (var item in Model)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <h5 class="card-title">
                        @if (item.User != null)
                        {
                            @item.User.FirstName @item.User.LastName
                        }
                        else
                        {
                            <span class="text-muted">Unknown User</span>
                        }
                    </h5>
                    <div class="d-flex align-items-center">
                        <small class="text-muted me-2">@item.CreatedAt.ToLocalTime().ToString("g")</small>
                        
                        @if (currentUser != null && (item.UserId == currentUser.Id || User.IsInRole("Administrator")))
                        {
                             <div class="dropdown">
                                <button class="btn btn-sm btn-link text-muted" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    ⋮
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.PostId">Edit</a></li>
                                    <li>
                                        <form asp-action="Delete" asp-route-id="@item.PostId" method="post" onsubmit="return confirm('Are you sure you want to delete this post?');">
                                            <button type="submit" class="dropdown-item text-danger">Delete</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
                
                <p class="card-text mt-2">@item.Content</p>

                @if (item.MediaType == MediaType.Image && !string.IsNullOrEmpty(item.MediaPath))
                {
                    <img src="@item.MediaPath" class="img-fluid mt-2 rounded" style="max-height: 500px; width: 100%; object-fit: cover;" alt="Post image" />
                }
                else if (item.MediaType == MediaType.Video && !string.IsNullOrEmpty(item.MediaPath))
                {
                    <video controls class="img-fluid mt-2 rounded" style="max-height: 500px; width: 100%;">
                        <source src="@item.MediaPath" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                }
                
                <div class="d-flex align-items-center mt-3">
                    <form asp-controller="Likes" asp-action="ToggleLike" method="post" class="me-3">
                        <input type="hidden" name="postId" value="@item.PostId" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <button type="submit" class="btn btn-sm @(currentUser != null && item.Likes.Any(l => l.UserId == currentUser.Id) ? "btn-danger" : "btn-outline-danger")">
                            ❤ @item.Likes.Count
                        </button>
                    </form>
                    
                    <a asp-action="Details" asp-route-id="@item.PostId" class="btn btn-sm btn-outline-secondary">
                        Comments (@item.Comments.Count)
                    </a>
                </div>
            </div>
        </div>
    }
</div>
