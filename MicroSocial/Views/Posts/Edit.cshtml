@model MicroSocial.Models.Post

@{
    ViewData["Title"] = "Edit Post";
}

<h1>Edit Post</h1>

<h4>Post</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="PostId" />
            <div class="form-group mb-3">
                <label asp-for="Content" class="control-label"></label>
                <textarea asp-for="Content" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.MediaPath))
            {
                <div class="mb-3">
                    <label>Current Media:</label>
                    <div class="border p-2 rounded">
                        @if (Model.MediaType == MediaType.Image)
                        {
                            <img src="@Model.MediaPath" class="img-fluid" style="max-height: 200px;" alt="Post Media" />
                        }
                        else if (Model.MediaType == MediaType.Video)
                        {
                            <video class="img-fluid" style="max-height: 200px;" controls>
                                <source src="@Model.MediaPath" type="video/mp4">
                                Your browser does not support the video tag.
                            </video>
                        }
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="removeMedia" name="removeMedia" value="true">
                        <label class="form-check-label text-danger" for="removeMedia">
                            Remove current media
                        </label>
                    </div>
                </div>
            }

            <div class="form-group mb-3">
                 <label class="control-label">Change/Upload Media (Image or Video)</label>
                 <input type="file" name="mediaFile" class="form-control" accept="image/*,video/*" />
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
