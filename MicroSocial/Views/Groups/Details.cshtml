@model MicroSocial.Models.Group
@using System.Security.Claims

@{
    ViewData["Title"] = Model.Name;
    var currentUserId = (string)ViewBag.CurrentUserId;
    var isMember = (bool)ViewBag.IsMember;
    var hasPendingRequest = (bool)ViewBag.HasPendingRequest;
    var isModerator = (bool)ViewBag.IsModerator;
}

<div class="container mt-4">
                    <div class="card">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h1 class="display-6">@Model.Name</h1>
                    <p class="lead text-muted">@Model.Description</p>
                    <p class="mb-0 small text-muted">Moderator: @(Model.Moderator != null ? $"{Model.Moderator.FirstName} {Model.Moderator.LastName}" : "Unknown")</p>
                </div>
                <div>
                    @if (isModerator)
                    {
                        <form asp-action="Delete" asp-route-id="@Model.GroupId" method="post" onsubmit="return confirm('Are you sure? This will delete the group and all messages!');">
                            <button type="submit" class="btn btn-danger">Delete Group</button>
                        </form>
                    }
                    else if (isMember)
                    {
                        <form asp-action="Leave" asp-route-id="@Model.GroupId" method="post" onsubmit="return confirm('Are you sure you want to leave this group?');">
                            <button type="submit" class="btn btn-warning text-white">Leave Group</button>
                        </form>
                    }
                    else if (hasPendingRequest)
                    {
                        <button class="btn btn-secondary" disabled>Request Sent</button>
                    }
                    else
                    {
                         <form asp-action="Join" asp-route-id="@Model.GroupId" method="post">
                            <button type="submit" class="btn btn-primary">Join Group</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Chat and Moderation Area -->
    @if (isMember)
    {
        <div class="row">
            <!-- Chat Column -->
            <div class="@(isModerator ? "col-md-8" : "col-md-12")">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Discussion</h5>
                    </div>
                    <div class="card-body d-flex flex-column" style="height: 600px;">
                        <!-- Messages Area -->
                        <div class="flex-grow-1 overflow-auto mb-3" id="messagelist" style="padding-right: 10px;">
                            @if (!Model.GroupMessages.Any())
                            {
                                <div class="text-center text-muted mt-5">
                                    <p>No messages yet. Say hello!</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var message in Model.GroupMessages)
                                {
                                    var isMine = message.UserId == currentUserId;
                                    <div class="d-flex mb-3 @(isMine ? "justify-content-end" : "justify-content-start")">
                                        <div class="card @(isMine ? "bg-primary text-white" : "bg-light")" style="max-width: 75%;">
                                            <div class="card-body p-2">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <small class="@(isMine ? "text-white-50" : "text-muted") fw-bold me-2">
                                                        @(message.User != null ? $"{message.User.FirstName} {message.User.LastName}" : "Unknown")
                                                    </small>
                                                    
                                                    @if (isMine)
                                                    {
                                                        <div class="dropdown">
                                                            <button class="btn btn-sm btn-link @(isMine ? "text-white" : "text-muted") p-0" type="button" data-bs-toggle="dropdown">
                                                                ⋮
                                                            </button>
                                                            <ul class="dropdown-menu">
                                                                <li><a class="dropdown-item" asp-controller="GroupMessages" asp-action="Edit" asp-route-id="@message.GroupMessageId">Edit</a></li>
                                                                <li>
                                                                    <form asp-controller="GroupMessages" asp-action="Delete" asp-route-id="@message.GroupMessageId" method="post" onsubmit="return confirm('Delete message?');">
                                                                        <button type="submit" class="dropdown-item text-danger">Delete</button>
                                                                    </form>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                    }
                                                </div>
                                                <p class="mb-0 text-break">@message.Content</p>
                                                <div class="text-end">
                                                    <small class="@(isMine ? "text-white-50" : "text-muted")" style="font-size: 0.7rem;">
                                                        @message.SentAt.ToString("g")
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                        
                        <!-- Input Area -->
                        <div class="border-top pt-3">
                            <form asp-controller="GroupMessages" asp-action="Create" method="post" class="d-flex gap-2">
                                <input type="hidden" name="GroupId" value="@Model.GroupId" />
                                <input type="text" name="Content" class="form-control" placeholder="Type a message..." required autocomplete="off" />
                                <button type="submit" class="btn btn-primary">Send</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Moderator Column -->
            @if (isModerator)
            {
                <div class="col-md-4">
                    <!-- Member Requests -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Join Requests</h5>
                        </div>
                        <div class="card-body p-0">
                            @{
                                var requests = Model.UserGroups.Where(ug => !ug.Status).ToList();
                            }
                            @if (!requests.Any())
                            {
                                <div class="p-3 text-muted text-center">No pending requests.</div>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var req in requests)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>@(req.User != null ? $"{req.User.FirstName} {req.User.LastName}" : "Unknown")</span>
                                            <div class="btn-group btn-group-sm">
                                                <form asp-action="AcceptRequest" method="post">
                                                    <input type="hidden" name="groupId" value="@Model.GroupId" />
                                                    <input type="hidden" name="userId" value="@req.UserId" />
                                                    <button type="submit" class="btn btn-success">✓</button>
                                                </form>
                                                <form asp-action="RejectRequest" method="post">
                                                    <input type="hidden" name="groupId" value="@Model.GroupId" />
                                                    <input type="hidden" name="userId" value="@req.UserId" />
                                                    <button type="submit" class="btn btn-danger">✗</button>
                                                </form>
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>

                    <!-- Members List -->
                    <div class="card shadow-sm">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Members (@Model.UserGroups.Count(ug => ug.Status))</h5>
                        </div>
                        <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                            <ul class="list-group list-group-flush">
                                @foreach (var member in Model.UserGroups.Where(ug => ug.Status))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <!-- Optionally add Avatar here -->
                                             <span>@(member.User != null ? $"{member.User.FirstName} {member.User.LastName}" : "Unknown")</span>
                                             @if (member.UserId == Model.ModeratorId)
                                             {
                                                 <span class="badge bg-info text-dark">Mod</span>
                                             }
                                        </div>
                                        @if (member.UserId != Model.ModeratorId)
                                        {
                                            <form asp-action="RejectRequest" method="post" onsubmit="return confirm('Kick this user?');">
                                                <input type="hidden" name="groupId" value="@Model.GroupId" />
                                                <input type="hidden" name="userId" value="@member.UserId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Kick">Kick</button>
                                            </form>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Non-member view (if they want to see basic info or splash screen) -->
        <div class="text-center py-5">
            <h3 class="text-muted">Join the group to view messages and participate!</h3>
        </div>
    }
</div>

<script>
    // Scroll to bottom of message list on load
    window.onload = function() {
        var objDiv = document.getElementById("messagelist");
        if(objDiv) objDiv.scrollTop = objDiv.scrollHeight;
    }
</script>
